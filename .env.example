# ── Railway environment variables ────────────────────────────────
# Set these in Railway → Project → Variables

APP_ENV=production
LOG_LEVEL=INFO

# JWT secret — change this to a long random string in production
JWT_SECRET=change-me-in-production

# CORS — set to your Vercel URL to restrict access
CORS_ORIGINS=["https://<your-app>.vercel.app"]

# LLM provider: "stub" (offline default) or "gemini"
LLM_PROVIDER=stub
GEMINI_API_KEY=

# Vision ingestion (scanned PDF pages, figures, images). Off per workspace until
# enabled in Settings → AI Settings. Empty model → GEMINI_MODEL.
VISION_MODEL=
VISION_MAX_IMAGES=20

# Supabase user sign-in. Blank: with APP_ENV=production only API keys can call
# the API (in development any bearer token is the dev user).
SUPABASE_URL=
SUPABASE_KEY=

# Demo mode: callers without credentials may query (never write) workspaces that
# are not registered organisations. Off by default: no credentials -> 401.
DEMO_MODE=false

# Observability — leave blank on Railway (no Jaeger/Prometheus)
OTEL_EXPORTER_ENDPOINT=
METRICS_ENABLED=true
